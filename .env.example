# WireGuard tunnel to the VPS (keys from `wg genkey`; the public key +
# endpoint are the server's, the address is this peer's slot on the mesh)
WG_PRIVATE_KEY=<wg genkey>
WG_ADDRESS=10.99.0.240/32
WG_PEER_PUBLIC_KEY=<server public key>
# Keep this to the VPS peer (/32) unless a full tunnel is really wanted:
# 0.0.0.0/0 also diverts the compose bridge and the LAN into the tunnel.
WG_PEER_ALLOWEDIPS=0.0.0.0/0
WG_PEER_ENDPOINT=<server-ip:port>
WG_PEER_PERSISTENT_KEEPALIVE=25
# Tunnel DNS (the VPS peer) — consumed by docker-compose.yml
WG_DNS=10.99.0.42

# Public URL of the noVNC backstop door; quoted in ntfy session messages
VNC_URL=https://ytcookies.example.com

# VNC password (x11vnc) and the extra HTTP basic-auth layer on VNC_URL
VNC_PASSWORD=<vnc password>
NOVNC_HTTP_USER=novnc
NOVNC_HTTP_PASS=<basic-auth password>

# Google account whose session this vault holds; auto_signin types the
# password when the session dies (presence of GOOGLE_PASSWORD enables it)
GOOGLE_EMAIL=<account>@example.com
GOOGLE_PASSWORD=<account password>

# ntfy.sh topic for session_dead / session_restored pushes (optional)
NTFY_TOPIC=<topic-slug>

# Fuzzed delay window (seconds) before auto sign-in types anything
AUTO_SIGNIN_DELAY_MIN=240
AUTO_SIGNIN_DELAY_MAX=1500
